{
  "pkg": "@jrk/design",
  "globalName": "JrkDesign",
  "projectId": "6ae6f5da-9e47-47eb-9e46-7d3cc6aa361a",
  "shape": "package",
  "buildCmd": "node .design-sync/prepare.mjs",
  "srcDir": "react/src",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".design-sync/.cache/jrk-flat.css",
  "docsDir": ".design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": [
    "guides/*.md"
  ],
  "overrides": {
    "SectionNav": {
      "cardMode": "column",
      "viewport": "1120x800"
    },
    "NavMenu": {
      "cardMode": "single",
      "primaryStory": "Open",
      "viewport": "900x700"
    },
    "BarList": {
      "cardMode": "column"
    },
    "Tag": {
      "cardMode": "column"
    },
    "Card": {
      "cardMode": "column"
    },
    "ChartCard": {
      "cardMode": "column"
    },
    "CellBarSigned": {
      "cardMode": "column"
    },
    "HeatLegend": {
      "cardMode": "column"
    },
    "OrgChart": {
      "cardMode": "column"
    },
    "OrgNode": {
      "cardMode": "column"
    },
    "Menu": {
      "cardMode": "single",
      "primaryStory": "Open",
      "viewport": "760x420"
    },
    "MenuItem": {
      "cardMode": "column"
    },
    "MenuLabel": {
      "cardMode": "column"
    },
    "MenuSeparator": {
      "cardMode": "column"
    },
    "SpotlightGuide": {
      "cardMode": "single",
      "primaryStory": "Open",
      "viewport": "900x620"
    },
    "Topbar": {
      "cardMode": "column"
    }
  },
  "runtimeFontPrefixes": [
    "SF Pro",
    "SF Mono"
  ],
  "extraFonts": [
    ".ds-sync/node_modules/@fontsource/inter/latin-400.css",
    ".ds-sync/node_modules/@fontsource/inter/latin-500.css",
    ".ds-sync/node_modules/@fontsource/inter/latin-600.css",
    ".ds-sync/node_modules/@fontsource/inter/latin-700.css",
    ".ds-sync/node_modules/@fontsource/jetbrains-mono/latin-400.css",
    ".ds-sync/node_modules/@fontsource/jetbrains-mono/latin-500.css"
  ]
}
